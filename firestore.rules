rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /invoices/{invoiceId} {
      // Only the owner can read, create, update, or delete their invoices
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    
    match /shared_invoices/{shareId} {
      // Anyone can read a shared invoice if it is active
      allow get: if resource.data.isActive == true;
      // List operations are denied for public shares to prevent scraping
      allow list: if false;
      // Only the owner can create, update, or delete a share record
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId) && isOwner(request.resource.data.userId);
    }
  }
}
